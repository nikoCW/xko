# AWS EC2 production-style environment for xko Nautilus Bridge.
# Copy to /etc/xko/nautilus-bridge.env and chmod 640 root:xko.
# Never commit real credentials or the bridge token.

# OKX credentials — use DEMO credentials until protective exits are implemented/tested.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Nautilus / OKX
OKX_DEMO=true
OKX_MARGIN_MODE=CROSS
OKX_INSTRUMENT_TYPE=SWAP

# Bridge API stays on loopback; Caddy terminates public HTTPS.
NAUTILUS_BRIDGE_HOST=127.0.0.1
NAUTILUS_BRIDGE_PORT=8765
BRIDGE_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN

# Durable SQLite path. Put this directory on EBS.
INTENT_DB_PATH=/var/lib/xko-nautilus/intents.db

# Hard risk policy
ALLOWED_INSTRUMENTS=BTC-USDT-SWAP.OKX,ETH-USDT-SWAP.OKX,SOL-USDT-SWAP.OKX
EQUITY_CURRENCY=USDT
MAX_RISK_PCT=0.50
MAX_ORDER_QTY=10
MAX_NOTIONAL_PER_ORDER_USDT=5000

# Safety switches — keep these values for the current V1 bridge.
ALLOW_ORDER_SUBMIT=false
ALLOW_UNPROTECTED_ENTRY=false
ALLOW_MARKET_ENTRY=false

# Nautilus engine throttles
MAX_ORDER_SUBMIT_RATE=5/00:00:01
MAX_ORDER_MODIFY_RATE=10/00:00:01
PREVIEW_TIMEOUT_SECS=10
