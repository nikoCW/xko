# AWS EC2 production-style environment for xko Nautilus Bridge.
# Copy to /etc/xko/nautilus-bridge.env and chmod 640 root:xko.
# Never commit real credentials or the bridge token.

# OKX credentials. Prefer dedicated Demo credentials for execution testing. If only
# LIVE credentials are available, keep ALLOW_ORDER_SUBMIT=false while validating.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Nautilus / OKX
OKX_DEMO=true
OKX_MARGIN_MODE=CROSS
OKX_INSTRUMENT_TYPE=SWAP

# Bridge API stays on loopback; Caddy terminates public HTTPS.
NAUTILUS_BRIDGE_HOST=127.0.0.1
NAUTILUS_BRIDGE_PORT=8765
BRIDGE_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN

# Durable SQLite path. Put this directory on EBS.
INTENT_DB_PATH=/var/lib/xko-nautilus/intents.db

# Hard risk policy
ALLOWED_INSTRUMENTS=BTC-USDT-SWAP.OKX,ETH-USDT-SWAP.OKX,SOL-USDT-SWAP.OKX
EQUITY_CURRENCY=USDT
MAX_RISK_PCT=0.50

# Legacy/fallback contract-count cap used only when an instrument has no explicit override.
MAX_ORDER_QTY=10
# Instrument-aware contract-count caps. Contract units are not comparable across swaps,
# so prefer explicit limits for every instrument XKO is allowed to trade.
# HYPE is shown as an example even if it is not currently in ALLOWED_INSTRUMENTS.
MAX_ORDER_QTY_BY_INSTRUMENT=BTC-USDT-SWAP.OKX:10,ETH-USDT-SWAP.OKX:50,SOL-USDT-SWAP.OKX:100,HYPE-USDT-SWAP.OKX:100
MAX_NOTIONAL_PER_ORDER_USDT=5000

# Safety switches. xko has no unprotected execution path: this MUST remain false.
# The protected path uses NautilusTrader 1.231 OKX venue-native attached TP/SL brackets.
# Keep order submission false until that attached-OCO path has been validated end-to-end
# in an environment where sending test orders is acceptable.
ALLOW_ORDER_SUBMIT=false
ALLOW_UNPROTECTED_ENTRY=false
ALLOW_MARKET_ENTRY=false

# Nautilus engine throttles
MAX_ORDER_SUBMIT_RATE=5/00:00:01
MAX_ORDER_MODIFY_RATE=10/00:00:01
PREVIEW_TIMEOUT_SECS=10
