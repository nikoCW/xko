[Unit]
Description=xko NautilusTrader OKX bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xko
Group=xko
WorkingDirectory=/opt/xko/nautilus_bridge
EnvironmentFile=/etc/xko/nautilus-bridge.env
ExecStart=/opt/xko/.venv/bin/python -m nautilus_service.main
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077

# systemd hardening. The bridge only needs its app tree read-only plus the EBS-backed DB path.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xko-nautilus

[Install]
WantedBy=multi-user.target
