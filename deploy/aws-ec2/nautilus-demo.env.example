# XKO OKX DEMO execution environment.
# Copy to /etc/xko/nautilus-demo.env, fill DEMO credentials locally, chmod 640 root:xko.
# NEVER paste real or demo credentials into chat or commit them to Git.

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Must remain DEMO for this service.
OKX_DEMO=true
OKX_MARGIN_MODE=CROSS
OKX_INSTRUMENT_TYPE=SWAP

# Separate loopback API and durable DB from LIVE shadow.
NAUTILUS_BRIDGE_HOST=127.0.0.1
NAUTILUS_BRIDGE_PORT=8775
BRIDGE_API_TOKEN=CHANGE_ME_TO_A_SEPARATE_LONG_RANDOM_TOKEN
INTENT_DB_PATH=/var/lib/xko-nautilus-demo/intents.db

# Start with a tiny, explicit demo-only universe/caps for venue lifecycle validation.
ALLOWED_INSTRUMENTS=BTC-USDT-SWAP.OKX,ETH-USDT-SWAP.OKX
EQUITY_CURRENCY=USDT
MAX_RISK_PCT=0.10
MAX_ORDER_QTY=1
MAX_ORDER_QTY_BY_INSTRUMENT=BTC-USDT-SWAP.OKX:1,ETH-USDT-SWAP.OKX:1
MAX_NOTIONAL_PER_ORDER_USDT=2500

# Phase 1: connection/reconciliation validation only. Keep submit false until DEMO health is green.
ALLOW_ORDER_SUBMIT=false
ALLOW_UNPROTECTED_ENTRY=false
ALLOW_MARKET_ENTRY=false

MAX_ORDER_SUBMIT_RATE=2/00:00:01
MAX_ORDER_MODIFY_RATE=5/00:00:01
PREVIEW_TIMEOUT_SECS=10
