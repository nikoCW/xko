# OKX credentials. Use DEMO credentials first.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Nautilus / OKX environment
OKX_DEMO=true
OKX_ACCOUNT_ID=OKX-001
OKX_MARGIN_MODE=CROSS
OKX_INSTRUMENT_TYPE=SWAP

# Local bridge HTTP server
NAUTILUS_BRIDGE_HOST=127.0.0.1
NAUTILUS_BRIDGE_PORT=8765
XKO_NAUTILUS_URL=http://127.0.0.1:8765

# Required when another process/network can reach protected bridge endpoints.
# Generate a long random value; never commit the real token.
BRIDGE_API_TOKEN=

# Durable intent DB
INTENT_DB_PATH=./data/intents.db

# Hard bridge policy
ALLOWED_INSTRUMENTS=BTC-USDT-SWAP.OKX,ETH-USDT-SWAP.OKX,SOL-USDT-SWAP.OKX
EQUITY_CURRENCY=USDT
MAX_RISK_PCT=0.50
MAX_ORDER_QTY=10
MAX_NOTIONAL_PER_ORDER_USDT=5000

# Safety switches
ALLOW_ORDER_SUBMIT=false
ALLOW_UNPROTECTED_ENTRY=false
ALLOW_MARKET_ENTRY=false

# Nautilus engine throttles
MAX_ORDER_SUBMIT_RATE=5/00:00:01
MAX_ORDER_MODIFY_RATE=10/00:00:01
PREVIEW_TIMEOUT_SECS=5
